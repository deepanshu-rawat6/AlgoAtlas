---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const patterns = await getCollection('patterns');
const sorted = patterns.sort((a, b) => a.data.phase - b.data.phase || a.data.title.localeCompare(b.data.title));
const totalProblems = sorted.reduce((n, p) => n + p.data.problemCount, 0);

const phaseLabels: Record<number, string> = {
  1: 'Phase 1 — The Core 50%',
  2: 'Phase 2 — Infrastructure (~30%)',
  3: 'Phase 3 — Differentiators (~20%)',
};
---

<BaseLayout title="AlgoAtlas">
  <div class="max-w-6xl mx-auto">

    <!-- Hero -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-2" style="color:var(--text)">AlgoAtlas</h1>
      <p style="color:var(--text-dim)">
        Frequency-based DSA learning — solve the right problems, in the right order.
      </p>
    </div>

    <!-- Stat strip -->
    <div class="stat-strip cols-4 mb-8">
      <div class="stat-cell">
        <div class="stat-value">{totalProblems}</div>
        <div class="stat-label">Problems</div>
      </div>
      <div class="stat-cell">
        <div class="stat-value">{sorted.length}</div>
        <div class="stat-label">Patterns</div>
      </div>
      <div class="stat-cell">
        <div class="stat-value">3</div>
        <div class="stat-label">Languages</div>
      </div>
      <div class="stat-cell">
        <div class="stat-value">3</div>
        <div class="stat-label">Phases</div>
      </div>
    </div>

    <!-- Search -->
    <div class="mb-8">
      <input
        type="text"
        id="pattern-search"
        placeholder="Search patterns…"
        class="sidebar-search"
        style="max-width:24rem"
        oninput="filterPatterns(this.value)"
      />
    </div>

    <!-- Frequency chart -->
    <div class="panel mb-10 p-6">
      <h2 class="text-base font-semibold mb-4" style="color:var(--text-secondary)">
        📊 Interview Frequency Map
      </h2>
      <pre><code class="language-mermaid">pie title Interview Frequency (Backend Engineering)
    "Trees & Graphs (BFS/DFS)" : 25
    "Arrays, Strings & Hashing" : 15
    "Two Pointers & Sliding Window" : 10
    "Priority Queues / Heaps" : 10
    "Binary Search (Modified)" : 10
    "Linked Lists & Stacks" : 10
    "Dynamic Programming" : 10
    "Backtracking & Greedy" : 10</code></pre>
    </div>

    <!-- Pattern grid by phase -->
    {[1, 2, 3].map(phase => (
      <div class="mb-10" data-phase={phase}>
        <h2 class="text-sm font-semibold uppercase tracking-wider mb-4 pb-2"
          style="color:var(--text-faint);border-bottom:1px solid var(--border)">
          {phaseLabels[phase]}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {sorted.filter(p => p.data.phase === phase).map(p => (
            <a
              href={`/pattern/${p.data.slug}`}
              class={`section-tile phase-${phase} pattern-card`}
              data-title={p.data.title.toLowerCase()}
            >
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-semibold text-sm" style="color:var(--text)">{p.data.title}</h3>
                <span class={`tier-chip phase-${phase} shrink-0`}>P{phase}</span>
              </div>
              {p.data.problemCount > 0 && (
                <p class="text-xs mt-2" style="color:var(--text-faint)">
                  {p.data.problemCount} problems
                </p>
              )}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <script>
    function filterPatterns(query: string) {
      const q = query.toLowerCase().trim();
      document.querySelectorAll<HTMLElement>('.pattern-card').forEach(card => {
        card.style.display = !q || (card.dataset.title || '').includes(q) ? '' : 'none';
      });
    }
    (window as any).filterPatterns = filterPatterns;
  </script>
</BaseLayout>
