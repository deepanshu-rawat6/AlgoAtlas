---
import { getCollection } from 'astro:content';
import { Code } from 'astro:components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Visualizer from '../../components/visualizers/Visualizer';
import fs from 'fs';
import path from 'path';
import { unified } from 'unified';
import rehypeExternalLinks from 'rehype-external-links';
import rehypeStringify from 'rehype-stringify';
import remarkParse from 'remark-parse';
import remarkGfm from 'remark-gfm';
import remarkRehype from 'remark-rehype';

export async function getStaticPaths() {
  const patterns = await getCollection('patterns');
  return patterns.map(p => ({ params: { slug: p.data.slug }, props: { pattern: p.data } }));
}

const { pattern } = Astro.props;
const { slug, title, phase } = pattern;

const dataDir = path.resolve('src/data/patterns', slug);

function readFile(file: string) {
  const p = path.join(dataDir, file);
  return fs.existsSync(p) ? fs.readFileSync(p, 'utf8') : null;
}

const readmeRaw = readFile('README.md');
const notesRaw  = readFile('NOTES.md');

async function renderMd(src: string | null): Promise<string> {
  if (!src) return '';
  const file = await unified()
    .use(remarkParse)
    .use(remarkGfm)
    .use(remarkRehype, { allowDangerousHtml: true })
    .use(rehypeExternalLinks, { target: '_blank', rel: ['noopener', 'noreferrer'] })
    .use(rehypeStringify, { allowDangerousHtml: true })
    .process(src);
  return String(file);
}

// Extract problem table from README for the Problems tab
function extractProblems(md: string | null): string | null {
  if (!md) return null;
  const lines = md.split('\n');
  const tableStart = lines.findIndex(l => l.trim().startsWith('|'));
  if (tableStart === -1) return null;
  let tableEnd = tableStart;
  while (tableEnd < lines.length && (lines[tableEnd].trim().startsWith('|') || lines[tableEnd].trim() === '')) {
    tableEnd++;
  }
  return lines.slice(tableStart, tableEnd).join('\n');
}

const problemsMd  = extractProblems(readmeRaw);
const readmeHtml  = await renderMd(readmeRaw);
const notesHtml   = await renderMd(notesRaw);
const problemsHtml = await renderMd(problemsMd);

// Multi-language solutions — grouped by problem name
const LANG_EXT:   Record<string, string> = { '.py': 'python', '.cpp': 'cpp', '.java': 'java' };
const LANG_LABEL: Record<string, string> = { '.py': 'Python', '.cpp': 'C++', '.java': 'Java' };
const LANG_ORDER = ['.py', '.cpp', '.java'];

type SolutionLang = { ext: string; label: string; lang: string; code: string };
type Solution     = { name: string; langs: SolutionLang[] };

const solutionsDir = path.join(dataDir, 'solutions');
const solutions: Solution[] = [];

if (fs.existsSync(solutionsDir)) {
  const byName = new Map<string, SolutionLang[]>();
  for (const file of fs.readdirSync(solutionsDir).sort()) {
    const ext = path.extname(file);
    if (!LANG_EXT[ext]) continue;
    const problem = path.basename(file, ext);
    if (!byName.has(problem)) byName.set(problem, []);
    const code = fs.readFileSync(path.join(solutionsDir, file), 'utf8');
    byName.get(problem)!.push({ ext, label: LANG_LABEL[ext], lang: LANG_EXT[ext], code });
  }
  for (const [problem, langs] of [...byName.entries()].sort()) {
    langs.sort((a, b) => LANG_ORDER.indexOf(a.ext) - LANG_ORDER.indexOf(b.ext));
    const name = problem.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    solutions.push({ name, langs });
  }
}

const VISUALIZER_PATTERNS = new Set([
  'sliding_window', 'two_pointers', 'graphs', 'binary_search', 'advanced_graphs',
  'arrays_and_hashing', 'stack', 'linked_list', 'trees', 'heap', 'intervals',
  '1d_dp', '2d_dp', 'backtracking', 'greedy', 'tries', 'bit_manipulation',
  'recursion', 'algorithms', 'strings', 'math_and_geometry',
]);
const hasVisualizer = VISUALIZER_PATTERNS.has(slug);

const tabs = ['overview', 'notes', 'problems', 'solutions', ...(hasVisualizer ? ['visualizer'] : [])];
---

<BaseLayout title={title}>

  <!-- Breadcrumb -->
  <nav class="crumb-trail mb-4">
    <a href="/">Home</a>
    <span class="sep">›</span>
    <span class="current">{title}</span>
  </nav>

  <!-- Page header -->
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-bold" style="color:var(--text)">{title}</h1>
    <span class={`tier-chip phase-${phase}`}>Phase {phase}</span>
    {solutions.length > 0 && (
      <span class="step-badge">{solutions.length} solutions</span>
    )}
  </div>

  <!-- Tab group -->
  <div class="tab-group mb-6">
    <div class="tab-buttons" id="tab-bar">
      {tabs.map(tab => (
        <button class="tab-btn" data-tab={tab}>{tab}</button>
      ))}
    </div>

    <!-- Overview -->
    <div id="tab-overview" class="tab-content tab-panel prose max-w-none">
      {readmeRaw
        ? <Fragment set:html={readmeHtml} />
        : <p style="color:var(--text-faint)">No overview available.</p>
      }
    </div>

    <!-- Notes -->
    <div id="tab-notes" class="tab-content tab-panel prose max-w-none">
      {notesRaw
        ? <Fragment set:html={notesHtml} />
        : <p style="color:var(--text-faint)">No notes available for this pattern.</p>
      }
    </div>

    <!-- Problems -->
    <div id="tab-problems" class="tab-content tab-panel">
      {problemsMd
        ? <Fragment set:html={problemsHtml} class="prose max-w-none" />
        : <div class="prose max-w-none"><Fragment set:html={readmeHtml} /></div>
      }
    </div>

    <!-- Solutions -->
    <div id="tab-solutions" class="tab-content tab-panel">
      {solutions.length === 0
        ? <p style="color:var(--text-faint)" class="py-4">No solutions available for this pattern.</p>
        : (
          <div class="space-y-2">
            {solutions.map((s, si) => (
              <details class="overflow-hidden rounded-lg" style="border:1px solid var(--border)">
                <summary class="px-4 py-3 cursor-pointer select-none flex items-center justify-between"
                  style="background:var(--surface-raised);color:var(--text-secondary);font-size:0.875rem;font-weight:500">
                  <div class="flex items-center gap-2">
                    <span>{s.name}</span>
                    {s.langs.map(l => (
                      <span class="step-badge" style="font-size:0.65rem">{l.label}</span>
                    ))}
                  </div>
                  <span style="color:var(--text-faint);font-size:0.75rem" class="group-open:hidden">▼</span>
                </summary>
                <div>
                  {s.langs.length > 1 && (
                    <div class="px-4 py-2 flex gap-2 lang-bar" data-sol={si}
                      style="background:var(--surface-raised);border-bottom:1px solid var(--border)">
                      {s.langs.map((l, li) => (
                        <button
                          class={`lang-pill viz-btn ${li === 0 ? 'viz-btn--primary' : ''}`}
                          style="font-size:0.72rem;padding:0.2rem 0.65rem"
                          data-sol={si} data-li={li}
                        >
                          {l.label}
                        </button>
                      ))}
                    </div>
                  )}
                  {s.langs.map((l, li) => (
                    <div class={`lang-pane overflow-x-auto max-h-[600px] overflow-y-auto ${li !== 0 ? 'hidden' : ''}`}
                      data-sol={si} data-li={li}>
                      <Code code={l.code} lang={l.lang} theme="github-dark" />
                    </div>
                  ))}
                </div>
              </details>
            ))}
          </div>
        )
      }
    </div>

    <!-- Visualizer -->
    {hasVisualizer && (
      <div id="tab-visualizer" class="tab-content tab-panel min-h-96">
        <Visualizer slug={slug} client:visible />
      </div>
    )}
  </div>

</BaseLayout>

<script>
  function initTabs() {
    const btns     = document.querySelectorAll<HTMLButtonElement>('#tab-bar .tab-btn');
    const contents = document.querySelectorAll<HTMLElement>('.tab-content');

    function activate(id: string) {
      const ids = Array.from(btns).map(b => b.dataset.tab!);
      const target = ids.includes(id) ? id : ids[0];
      btns.forEach(b => b.classList.toggle('active', b.dataset.tab === target));
      contents.forEach(c => c.classList.toggle('active', c.id === `tab-${target}`));
    }

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        history.replaceState(null, '', `#${btn.dataset.tab}`);
        activate(btn.dataset.tab!);
      });
    });
    activate(location.hash.replace('#', '') || 'overview');
  }

  function initLangSwitcher() {
    document.querySelectorAll<HTMLButtonElement>('.lang-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const sol = btn.dataset.sol!;
        const li  = btn.dataset.li!;
        document.querySelectorAll<HTMLButtonElement>(`.lang-pill[data-sol="${sol}"]`).forEach(b => {
          const active = b.dataset.li === li;
          b.classList.toggle('viz-btn--primary', active);
        });
        document.querySelectorAll<HTMLElement>(`.lang-pane[data-sol="${sol}"]`).forEach(p => {
          p.classList.toggle('hidden', p.dataset.li !== li);
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => { initTabs(); initLangSwitcher(); });
</script>
