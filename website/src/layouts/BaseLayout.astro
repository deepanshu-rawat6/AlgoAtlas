---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Learn DSA patterns with visual diagrams and interactive animations' } = Astro.props;
const patterns = await getCollection('patterns');
const sorted = patterns.sort((a, b) => a.data.phase - b.data.phase || a.data.title.localeCompare(b.data.title));
const currentSlug = Astro.url.pathname.split('/').pop();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | AlgoAtlas</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="min-h-screen flex flex-col bg-slate-900 text-slate-200">
  <header class="border-b border-slate-800 px-6 py-4 flex items-center gap-4">
    <a href="/" class="text-xl font-bold text-blue-400 hover:text-blue-300">AlgoAtlas</a>
    <span class="text-slate-500 text-sm hidden sm:block">Frequency-Based Learning Roadmap</span>
  </header>

  <div class="flex flex-1 overflow-hidden">
    <!-- Sidebar -->
    <nav class="hidden lg:flex flex-col w-56 border-r border-slate-800 overflow-y-auto py-4 shrink-0">
      <!-- Sidebar search -->
      <div class="px-3 pb-3">
        <input
          type="text"
          id="sidebar-search"
          placeholder="Filter patterns…"
          class="w-full bg-slate-800 border border-slate-700 rounded-md px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-blue-500 transition-colors"
        />
      </div>
      {[1, 2, 3].map(phase => (
        <div class="mb-4 sidebar-phase" data-phase={phase}>
          <div class="px-4 py-1 text-xs font-semibold text-slate-500 uppercase tracking-wider">Phase {phase}</div>
          {sorted.filter(p => p.data.phase === phase).map(p => (
            <a
              href={`/pattern/${p.data.slug}`}
              data-title={p.data.title.toLowerCase()}
              class={`sidebar-link block px-4 py-1.5 text-sm hover:bg-slate-800 hover:text-blue-400 transition-colors ${currentSlug === p.data.slug ? 'bg-slate-800 text-blue-400 border-l-2 border-blue-400' : 'text-slate-400'}`}
            >
              {p.data.title}
            </a>
          ))}
        </div>
      ))}
    </nav>

    <!-- Main content -->
    <main class="flex-1 overflow-y-auto p-6">
      <slot />
    </main>
  </div>

  <script>
    // Mermaid rendering
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ startOnLoad: false, theme: 'dark', securityLevel: 'loose' });

    function renderMermaid() {
      document.querySelectorAll('pre > code.language-mermaid').forEach((el, i) => {
        const pre = el.parentElement!;
        const src = el.textContent || '';
        const div = document.createElement('div');
        div.className = 'mermaid my-6';
        div.id = `mermaid-${Date.now()}-${i}`;
        div.textContent = src;
        pre.replaceWith(div);
      });
      mermaid.run();
    }

    // Difficulty badge replacement: 🟢→Easy, 🟡→Medium, 🔴→Hard
    function renderBadges() {
      document.querySelectorAll('.prose td').forEach(td => {
        const text = td.textContent || '';
        if (text.includes('🟢')) {
          td.innerHTML = td.innerHTML.replace(/🟢\s*(Easy)?/g, '<span class="badge-easy">Easy</span>');
        } else if (text.includes('🟡')) {
          td.innerHTML = td.innerHTML.replace(/🟡\s*(Medium)?/g, '<span class="badge-medium">Medium</span>');
        } else if (text.includes('🔴')) {
          td.innerHTML = td.innerHTML.replace(/🔴\s*(Hard)?/g, '<span class="badge-hard">Hard</span>');
        }
      });
    }

    function initSidebarSearch() {
      const input = document.getElementById('sidebar-search') as HTMLInputElement | null;
      if (!input) return;
      input.addEventListener('input', () => {
        const q = input.value.toLowerCase().trim();
        document.querySelectorAll<HTMLElement>('.sidebar-link').forEach(link => {
          const match = !q || (link.dataset.title || '').includes(q);
          link.style.display = match ? '' : 'none';
        });
      });
    }

    function init() {
      renderMermaid();
      renderBadges();
      initSidebarSearch();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</body>
</html>
