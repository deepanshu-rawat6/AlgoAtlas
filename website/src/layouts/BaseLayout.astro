---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Learn DSA patterns with visual diagrams and interactive animations' } = Astro.props;
const patterns = await getCollection('patterns');
const sorted = patterns.sort((a, b) => a.data.phase - b.data.phase || a.data.title.localeCompare(b.data.title));
const currentSlug = Astro.url.pathname.split('/').filter(Boolean).pop();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | AlgoAtlas</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Apply saved theme before first paint to prevent flash -->
  <script is:inline>
    (function(){
      var t = localStorage.getItem('algoatlas-theme');
      if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.dataset.theme = 'dark';
      }
    })();
  </script>
</head>
<body class="min-h-screen flex flex-col" style="background:var(--bg);color:var(--text)">

  <!-- Header -->
  <header class="site-header px-6 py-3.5 flex items-center gap-5">
    <a href="/" class="wordmark">
      <span class="prompt">❯</span>
      AlgoAtlas
      <span class="cursor"></span>
    </a>
    <span style="color:var(--text-faint);font-size:0.8rem" class="hidden sm:block">
      Frequency-Based DSA Roadmap
    </span>
    <div class="ml-auto flex items-center gap-3">
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <span class="dot"></span>
        <span id="theme-label">Theme</span>
      </button>
    </div>
  </header>

  <div class="flex flex-1 overflow-hidden">
    <!-- Sidebar -->
    <nav class="sidebar hidden lg:flex flex-col w-64 overflow-y-auto py-4 shrink-0">
      <!-- Search -->
      <div class="px-3 pb-3">
        <input type="text" id="sidebar-search" placeholder="Filter patterns…"
          class="sidebar-search" autocomplete="off" />
      </div>

      {[1, 2, 3].map(phase => (
        <details open class="sidebar-phase" data-phase={phase}>
          <summary class="sidebar-summary">
            Phase {phase}
          </summary>
          {sorted.filter(p => p.data.phase === phase).map(p => (
            <a
              href={`/pattern/${p.data.slug}`}
              data-title={p.data.title.toLowerCase()}
              class={`sidebar-link ${currentSlug === p.data.slug ? 'active' : ''}`}
            >
              {p.data.title}
            </a>
          ))}
        </details>
      ))}
    </nav>

    <!-- Main content -->
    <main class="flex-1 overflow-y-auto p-6" style="background:var(--bg)">
      <slot />
    </main>
  </div>

  <script>
    // ── Mermaid ──────────────────────────────────────────────────────
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

    const mermaidStore: Array<{ el: HTMLElement; src: string }> = [];

    function getMermaidTheme() {
      const t = document.documentElement.dataset.theme;
      if (t) return t === 'dark' ? 'dark' : 'default';
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'default';
    }

    mermaid.initialize({ startOnLoad: false, theme: getMermaidTheme(), securityLevel: 'loose' });

    function renderMermaid() {
      document.querySelectorAll('pre > code.language-mermaid').forEach((el, i) => {
        const pre = el.parentElement!;
        const src = el.textContent || '';
        const div = document.createElement('div');
        div.className = 'mermaid my-6';
        div.id = `mermaid-${Date.now()}-${i}`;
        div.textContent = src;
        mermaidStore.push({ el: div, src });
        pre.replaceWith(div);
      });
      mermaid.run();
    }

    function rerenderMermaid(theme: string) {
      if (mermaidStore.length === 0) return;
      mermaid.initialize({ startOnLoad: false, theme, securityLevel: 'loose' });
      mermaidStore.forEach(({ el, src }) => {
        el.removeAttribute('data-processed');
        el.innerHTML = '';
        el.textContent = src;
      });
      mermaid.run({ nodes: mermaidStore.map(m => m.el) });
    }

    // ── Difficulty badges ────────────────────────────────────────────
    function renderBadges() {
      document.querySelectorAll('.prose td').forEach(td => {
        const text = td.textContent || '';
        if (text.includes('🟢')) {
          td.innerHTML = td.innerHTML.replace(/🟢\s*(Easy)?/g, '<span class="badge-easy">Easy</span>');
        } else if (text.includes('🟡')) {
          td.innerHTML = td.innerHTML.replace(/🟡\s*(Medium)?/g, '<span class="badge-medium">Medium</span>');
        } else if (text.includes('🔴')) {
          td.innerHTML = td.innerHTML.replace(/🔴\s*(Hard)?/g, '<span class="badge-hard">Hard</span>');
        }
      });
    }

    // ── Sidebar search ───────────────────────────────────────────────
    function initSidebarSearch() {
      const input = document.getElementById('sidebar-search') as HTMLInputElement | null;
      if (!input) return;
      input.addEventListener('input', () => {
        const q = input.value.toLowerCase().trim();
        document.querySelectorAll<HTMLElement>('.sidebar-link').forEach(link => {
          link.style.display = !q || (link.dataset.title || '').includes(q) ? '' : 'none';
        });
      });
    }

    // ── Theme toggle ─────────────────────────────────────────────────
    function initTheme() {
      const btn = document.getElementById('theme-toggle');
      const label = document.getElementById('theme-label');
      if (!btn || !label) return;

      function getTheme() {
        return document.documentElement.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      }

      function updateLabel() {
        label.textContent = getTheme() === 'dark' ? 'Dark' : 'Light';
      }

      updateLabel();

      btn.addEventListener('click', () => {
        const current = getTheme();
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('algoatlas-theme', next);
        updateLabel();
        rerenderMermaid(next === 'dark' ? 'dark' : 'default');
      });
    }

    function init() {
      renderMermaid();
      renderBadges();
      initSidebarSearch();
      initTheme();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</body>
</html>
